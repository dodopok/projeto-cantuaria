# Supabase Configuration
# Chave pública (usada pelo Nuxt Supabase no browser com RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Chave privada (USAR APENAS NO SERVIDOR - server/api)
# Esta chave ignora o RLS e permite controle total no backend
SUPABASE_SERVICE_KEY=your-service-role-key

# AI Configuration
PERPLEXITY_API_KEY=your-perplexity-key
GEMINI_API_KEY=your-gemini-key

# YouTube Data API (para análise automática de vídeos)
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
